DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 远程 Embedding（主用，通过 SiliconFlow / OpenAI 兼容 API，失败时回退到本地模型）
EMBEDDING_REMOTE_API_KEY=
EMBEDDING_REMOTE_MODEL=Qwen/Qwen3-VL-Embedding-8B
EMBEDDING_REMOTE_BASE_URL=https://api.siliconflow.cn/v1

# 本地Embedding（可选 — 仅在 EMBEDDING_REMOTE_API_KEY 未设置时使用）
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_SOURCE=modelscope
EMBEDDING_DEVICE=mps
EMBEDDING_AUTO_DOWNLOAD=true
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_DIM=1024

# 重排序器（cross-encoder，用于检索结果重新排序）
RERANKER_ENABLED=true
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=mps
RERANKER_AUTO_DOWNLOAD=true
RERANKER_MAX_LENGTH=1024
RERANK_TOP_K=8
RERANKER_REMOTE_ENABLED=true
RERANKER_REMOTE_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REMOTE_BASE_URL=https://api.siliconflow.cn/v1

# MinerU 云 API（主解析器）
MINERU_API_BASE_URL=https://mineru.net
MINERU_API_KEY=
MINERU_API_TIMEOUT=300
MINERU_API_POLL_INTERVAL=2.0
MINERU_API_MAX_POLL_TIME=600

# 本地 MinerU（可选 — 仅在 MINERU_API_KEY 未设置时使用）
MAX_CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
UPLOAD_MAX_BYTES=52428800
APP_ENV=development
MINERU_TORCH_DEVICE=mps
MINERU_DISABLE_OCR=true
MINERU_TABLE_ENABLE=true
MINERU_FORMULA_ENABLE=true
MINERU_SHOW_DOWNLOAD_PROGRESS=true

# 多模型 Fallback（可选 — DeepSeek 不可用时自动降级）
LLM_FALLBACK_ENABLED=false
# Fallback 1：OpenAI 兼容 API（GLM / Qwen / SiliconFlow 等）
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=glm-4-flash
# Fallback 2：本地 Ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b

# 检索参数
RETRIEVAL_TOP_K=5
BM25_TOP_K=8
DENSE_TOP_K=8
SEED_TOP_K=8
RRF_K=60
MAX_EXPANDED_CHUNKS=8
SAME_SECTION_WINDOW=0
ADJACENT_WINDOW=1
INCLUDE_LINKED_BLOCKS=false

# JWT 密钥（用于身份验证和加密）
JWT_SECRET_KEY=e75a7798c49ec60851d2f3fffa61d5d8299fc733209eac277f5817f7248669ce